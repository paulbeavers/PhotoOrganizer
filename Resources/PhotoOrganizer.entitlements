<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Run in the App Sandbox. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Read/write folders the user picks in open panels or drags in (photos, sidecars, data folder). -->
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <!-- Remember those folders across launches with security-scoped bookmarks. -->
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
    <!-- ~/Pictures: the default sidebar folder and default data folder location. -->
    <key>com.apple.security.assets.pictures.read-write</key><true/>
    <!-- Read-only access to mounted volumes, so memory cards and cameras can be imported from
         without a permission prompt for every card. (A temporary-exception entitlement: fine for
         Developer ID distribution, not allowed on the Mac App Store.) Writing elsewhere, e.g. a
         backup drive, still needs the user's choice in an open panel. -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
    <array><string>/Volumes/</string></array>
    <!-- Read-only access to the home folder, for the import window's folder tree (browse and
         import from any folder, like Finder). macOS still asks once before Desktop, Documents and
         Downloads are read. Writing stays limited to the data folder and folders the user chose. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array><string>/</string></array>
</dict>
</plist>
